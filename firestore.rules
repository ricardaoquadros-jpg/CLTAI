/**
 * @fileoverview Firestore Security Rules for Financial Glimpse.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model. Each user can only
 * access their own profile data and associated transactions.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profile data. The `userId` must match the
 *   Firebase Auth UID.
 * - /users/{userId}/transactions/{transactionId}: Stores transaction records
 *   for a specific user. The `userId` segment in the path must match the
 *   Firebase Auth UID.
 *
 * Key Security Decisions:
 * - User listing is disallowed.
 *
 * Denormalization for Authorization:
 * - Transactions are stored as subcollections under the /users/{userId} path
 *   and each transaction document contains a `userId` field, which is redundant but makes the authorization rule simpler and more efficient because it doesn't require `get()` calls.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Protects the user profiles. Only the user can read, create, update, or delete their own profile.
     * @path /users/{userId}
     * @allow (create) If the user is creating their own profile (auth.uid matches userId).
     * @allow (get) If the user is reading their own profile (auth.uid matches userId).
     * @allow (update) If the user is updating their own profile (auth.uid matches userId).
     * @deny (create) If the user attempts to create a profile with a different userId than their auth.uid.
     * @deny (get) If the user attempts to read a profile with a different userId than their auth.uid.
     * @deny (update) If the user attempts to update a profile with a different userId than their auth.uid.
     * @principle Enforces document ownership. Users can only access their own profile.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if false;
    }

    /**
     * @description Protects the transaction records for each user. Only the user can read or write their own transaction data.
     * @path /users/{userId}/transactions/{transactionId}
     * @allow (create) If the user is creating a transaction under their own user ID (auth.uid matches userId).
     * @allow (get) If the user is reading a transaction under their own user ID (auth.uid matches userId).
     * @allow (update) If the user is updating a transaction under their own user ID (auth.uid matches userId).
     * @allow (delete) If the user is deleting a transaction under their own user ID (auth.uid matches userId).
     * @deny (create) If the user attempts to create a transaction under a different user ID than their auth.uid.
     * @deny (get) If the user attempts to read a transaction under a different user ID than their auth.uid.
     * @deny (update) If the user attempts to update a transaction under a different user ID than their auth.uid.
     * @deny (delete) If the user attempts to delete a transaction under a different user ID than their auth.uid.
     * @principle Enforces document ownership. Users can only access their own transaction records.
     */
    match /users/{userId}/transactions/{transactionId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) && resource != null;
      allow delete: if isOwner(userId) && resource != null;
    }
  }

  // Helper functions
  function isSignedIn() {
    return request.auth != null;
  }

  function isOwner(userId) {
    return isSignedIn() && request.auth.uid == userId;
  }
}