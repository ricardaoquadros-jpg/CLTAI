rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Grants access only to the user with a matching UID.
     * @path /users/{userId}
     * @allow (create) - User C0FJa5JCmGcQC0mOILvEBxxHcye2 creates their profile with matching userId.
     * @deny (create) - User DUmmyId attempts to create profile for C0FJa5JCmGcQC0mOILvEBxxHcye2.
     * @allow (get, update, delete) - User C0FJa5JCmGcQC0mOILvEBxxHcye2 accesses their profile.
     * @deny (get, update, delete) - User DUmmyId attempts to access profile C0FJa5JCmGcQC0mOILvEBxxHcye2.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;

      allow create: if isSignedIn() && isOwner(userId) && request.auth.uid == userId;
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Grants access only to the owner of the bank account.
     * @path /users/{userId}/bankAccounts/{bankAccountId}
     * @allow (create, get, update, delete) - User C0FJa5JCmGcQC0mOILvEBxxHcye2 creates, reads, updates, or deletes their bank account.
     * @deny (create, get, update, delete) - User DUmmyId attempts to access bank account of C0FJa5JCmGcQC0mOILvEBxxHcye2.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId}/bankAccounts/{bankAccountId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;

      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Grants access only to the owner of the investment account.
     * @path /users/{userId}/investmentAccounts/{investmentAccountId}
     * @allow (create, get, update, delete) - User C0FJa5JCmGcQC0mOILvEBxxHcye2 creates, reads, updates, or deletes their investment account.
     * @deny (create, get, update, delete) - User DUmmyId attempts to access investment account of C0FJa5JCmGcQC0mOILvEBxxHcye2.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId}/investmentAccounts/{investmentAccountId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;

      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Grants access only to the owner of the income record.
     * @path /users/{userId}/incomes/{incomeId}
     * @allow (create, get, update, delete) - User C0FJa5JCmGcQC0mOILvEBxxHcye2 creates, reads, updates, or deletes their income record.
     * @deny (create, get, update, delete) - User DUmmyId attempts to access income record of C0FJa5JCmGcQC0mOILvEBxxHcye2.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId}/incomes/{incomeId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;

      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Grants access only to the owner of the expense record.
     * @path /users/{userId}/expenses/{expenseId}
     * @allow (create, get, update, delete) - User C0FJa5JCmGcQC0mOILvEBxxHcye2 creates, reads, updates, or deletes their expense record.
     * @deny (create, get, update, delete) - User DUmmyId attempts to access expense record of C0FJa5JCmGcQC0mOILvEBxxHcye2.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId}/expenses/{expenseId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;

      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }
  }
}