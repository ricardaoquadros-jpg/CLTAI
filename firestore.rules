/**
  * @description This ruleset enforces a strict user-ownership model for the Financial Glimpse application.
  * Only authenticated users can access their own data.
  *
  * @dataStructure
  * The data is organized hierarchically under `/users/{userId}`, where `{userId}` corresponds to the Firebase Auth UID.
  * User profiles and associated data (transactions, bank accounts, investment accounts, income records) are stored as documents
  * within this user-specific path.
  *
  * @keySecurityDecisions
  * - Users can only create, read, update, and delete their own profile data.
  * - Transactions are stored under a user's profile and are only accessible to that user.
  * - Listing of user documents is disallowed.
  *
  * @denormalizationForAuthorization
  * - The `userId` is denormalized into the `BankAccount`, `InvestmentAccount`, `Income` and `Transaction` documents to simplify
  *   authorization checks and avoid costly `get()` operations. This allows direct validation of ownership.
  *   For example, a transaction document will contain both its own ID and the `userId` of the user who owns it.
  *
  * @structuralSegregation
  * - All private user data is stored under the `/users/{userId}` collection, ensuring that only the authenticated user can access it.
  */
 

 rules_version = '2';
 service cloud.firestore {
  match /databases/{database}/documents {
 

   /**
    * @description Enforces user-ownership for user profile data. Only the authenticated user can create, read, update, and delete their own profile.
    * @path /users/{userId}
    * @allow (create) - User with UID 'user123' can create a profile document at /users/user123 if authenticated as 'user123'.
    * @allow (get) - User with UID 'user123' can read their profile document at /users/user123 if authenticated as 'user123'.
    * @allow (update) - User with UID 'user123' can update their profile document at /users/user123 if authenticated as 'user123'.
    * @deny (create) - User with UID 'user456' cannot create a profile document at /users/user123 if authenticated as 'user456'.
    * @deny (get) - User with UID 'user456' cannot read the profile document at /users/user123 if authenticated as 'user456'.
    * @deny (update) - User with UID 'user456' cannot update the profile document at /users/user123 if authenticated as 'user456'.
    * @principle Enforces document ownership for writes.
    */
   match /users/{userId} {
    allow get: if request.auth.uid == userId;
    allow list: if false;
    allow create: if request.auth.uid == userId;
    allow update: if request.auth.uid == userId && resource.id == request.auth.uid;
    allow delete: if request.auth.uid == userId && resource.id == request.auth.uid;
   }
 

   /**
    * @description Enforces user-ownership for transaction data. Only the authenticated user can create, read, update, and delete their own transactions.
    * @path /users/{userId}/transactions/{transactionId}
    * @allow (create) - User with UID 'user123' can create a transaction document at /users/user123/transactions/trans1 if authenticated as 'user123'.
    * @allow (get) - User with UID 'user123' can read their transaction document at /users/user123/transactions/trans1 if authenticated as 'user123'.
    * @allow (update) - User with UID 'user123' can update their transaction document at /users/user123/transactions/trans1 if authenticated as 'user123'.
    * @allow (delete) - User with UID 'user123' can delete their transaction document at /users/user123/transactions/trans1 if authenticated as 'user123'.
    * @deny (create) - User with UID 'user456' cannot create a transaction document at /users/user123/transactions/trans1 if authenticated as 'user456'.
    * @deny (get) - User with UID 'user456' cannot read the transaction document at /users/user123/transactions/trans1 if authenticated as 'user456'.
    * @deny (update) - User with UID 'user456' cannot update the transaction document at /users/user123/transactions/trans1 if authenticated as 'user456'.
    * @deny (delete) - User with UID 'user456' cannot delete the transaction document at /users/user123/transactions/trans1 if authenticated as 'user456'.
    * @principle Enforces document ownership for writes.
    */
   match /users/{userId}/transactions/{transactionId} {
    allow get: if request.auth.uid == userId;
    allow list: if false;
    allow create: if request.auth.uid == userId;
    allow update: if request.auth.uid == userId;
    allow delete: if request.auth.uid == userId;
   }
  }
 }