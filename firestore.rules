/**
 * @fileoverview Firestore Security Rules for Financial Glimpse.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model. Each user can only
 * access their own data, preventing unauthorized access to other users'
 * financial information. The rules are designed to be secure-by-default,
 * explicitly denying any access not specifically granted.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profile information. The {userId} is
 *   enforced to match the Firebase Auth UID.
 * - /users/{userId}/transactions/{transactionId}: Stores transaction
 *   information for each user. The userId path segment must match the userId
 *   field within the transaction document.
 *
 * Key Security Decisions:
 * - User listing is disallowed to protect user privacy.
 * - All write operations are validated against the authenticated user's UID
 *   to ensure data integrity and prevent impersonation.
 *
 * Denormalization for Authorization:
 * - The `Transaction` documents in `/users/{userId}/transactions/{transactionId}`
 *   include a `userId` field that must match the `userId` path segment.
 *   This denormalization enables secure and efficient authorization checks
 *   without requiring additional database reads.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile documents.
     * @path /users/{userId}
     * @allow (create) Authenticated user can create their own profile.
     * @deny (create) Creating a profile with a mismatched userId.
     * @allow (get, update, delete) Authenticated user can read/update/delete their own profile.
     * @deny (get, update, delete) Accessing another user's profile.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow get: if isOwner(userId);
      allow list: if false;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to transaction documents for a specific user.
     * @path /users/{userId}/transactions/{transactionId}
     * @allow (create) Authenticated user can create transactions for themselves.
     * @deny (create) Creating a transaction with a mismatched userId.
     * @allow (get, list, update, delete) Authenticated user can read/list/update/delete their own transactions.
     * @deny (get, list, update, delete) Accessing another user's transactions.
     * @principle Enforces document ownership and relational integrity.
     */
    match /users/{userId}/transactions/{transactionId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow update: if isExistingOwner(userId) && request.resource.data.userId == userId;
      allow delete: if isExistingOwner(userId);
    }
  }
}